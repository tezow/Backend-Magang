# Server & CORS Configuration
CORS_ORIGINS=*
FRONTEND_URL=https://building.example.com

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/building?sslmode=disable
MAINTENANCE_DATABASE_URL=postgresql://user:password@localhost:5432/maintenance?sslmode=disable

# Postgres Pool & Timeouts
PG_CONN_TIMEOUT_MS=10000
PG_IDLE_TIMEOUT_MS=30000
PG_KEEP_ALIVE=true
PG_POOL_MAX=20

# Google Service Configuration
EMAIL_USER=your_email@example.com
GOOGLE_DOC_TOKEN_PATH=/path/to/token_doc.json
GOOGLE_TOKEN_PATH=/path/to/token.json
MASTER_DRIVE_FOLDER_ID=your_master_drive_folder_id

# Puppeteer Runtime Configuration
NPM_CONFIG_IGNORE_SCRIPTS=false
PUPPETEER_CACHE_DIR=/path/to/puppeteer/cache
PUPPETEER_NAVIGATION_TIMEOUT_MS=120000
PUPPETEER_SKIP_DOWNLOAD=false

# SSO & Authentication
SSO_EXCHANGE_URL=https://api-login.example.com/v1/sso/exchange
SSO_JWT_SECRET=your_sso_jwt_secret_key_min_16_chars
SPARTA_SSO_API_URL=https://api-login.example.com
SPARTA_INTERNAL_API_KEY=your_sparta_internal_api_key_min_16_chars
AUTH_ENFORCEMENT_MODE=strict
AUTH_SESSION_TTL_HOURS=12
AUTH_ROLLING_SESSION=true
AUTH_SESSION_RETENTION_DAYS=30

# Web Push Notification (VAPID Keys)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
